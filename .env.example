# Copy to .env on the host. Never commit .env.
# Shared secret the IOI API presents in X-Api-Key. Generate: openssl rand -hex 32
NATAL_API_KEY=
# 1 = allow unauthenticated (rate-limited) chart computation for a public tool.
PUBLIC_COMPUTE=0
# Browser origins allowed to call /v1/chart directly, comma separated.
ALLOWED_ORIGINS=https://illustriousorderilluminat.org
RATE_LIMIT_PER_MINUTE=60
# Where the complete corresponding source lives (AGPL §13). Served at / and /source.
SOURCE_URL=https://github.com/hclara23/ioi-natal-engine
NATAL_TAG=latest
